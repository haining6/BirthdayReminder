<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_bg">#FFFFF8F7</color>
    <color name="ring_bg">#FF2A1418</color>

    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorAccent">#FFE2545C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Ring" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ring_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
